{
	"compilerOptions": {
		"module": "CommonJS",
		"moduleResolution": "node",
		"target": "ES2022",
		"rootDir": "scripts",
		"outDir": "scripts",
		"lib": ["ES2022"],
		"sourceMap": true,
		"strict": true,
		"skipLibCheck": true,
		"ignoreDeprecations": "6.0",
		"types": ["node"]
	},
	"include": ["scripts/**/*.ts"],
	"exclude": ["node_modules"]
}
