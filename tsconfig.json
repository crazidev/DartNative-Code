{
	// Try to keep synced with Flutter extension!
	"compilerOptions": {
		"module": "Node16",
		"moduleResolution": "Node16",
		"target": "ES2022",
		"outDir": "out/src",
		"lib": [
			"ES2022"
		],
		"sourceMap": true,
		"rootDir": "src",
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		".crash_dumps",
		".dart_code_test_data_dir",
		".dcud",
		".dart_code_test_logs",
		".vscode-test",
		"node_modules",
		"out",
		"scripts",
		"src/test/test_projects",
		"website",
		"landing"
		// tsconfig.build.json excludes additional paths
	]
}
